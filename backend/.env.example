# Backend server
PORT=4000

# Allowed frontend origin (CRA now, Vite later)
FRONTEND_ORIGIN=http://localhost:3000

# Supabase project credentials (fill from Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name used for uploaded manuscripts / files
SUPABASE_STORAGE_BUCKET=manuscripts

# JWT secret for backend-issued tokens. Required: the server will not start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
