# Backend server
PORT=4000

# Allowed frontend origin (CRA now, Vite later)
FRONTEND_ORIGIN=http://localhost:3000

# Set to true when the API runs behind a reverse proxy (Nginx, Render) so sign-in
# rate limits see each client's IP instead of the proxy's.
TRUST_PROXY=false

# Supabase project credentials (fill from Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name used for uploaded manuscripts / files
SUPABASE_STORAGE_BUCKET=manuscripts

# JWT secret for backend-issued tokens. Required: the server will not start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional email (verification codes and workflow emails).
# EMAIL_PROVIDER=brevo sends through Brevo's free HTTP API; anything else (or no key) only logs emails.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# The sender must be verified in Brevo (Senders & IPs > Senders).
EMAIL_FROM=
EMAIL_FROM_NAME=IJEPA Editorial Office
# Public site URL used for links in emails (falls back to FRONTEND_ORIGIN).
SITE_URL=http://localhost:3005
